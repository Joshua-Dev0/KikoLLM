{
  "config": {
    "model": {
      "type": "decoder-only-transformer",
      "parameters": "10-20M",
      "training_precision": "float32"
    },
    "input_layer": {
      "type": "token_embedding",
      "row": 8000,
      "col": 256
    },
    "transformer": {
      "n-layers": 6,
      "repeat": 6,
      "attention": {
        "n-heads": 8,
        "head-dim": 32,
        "causal": true
      },
      "normalization": {
        "type": "rmsnorm",
        "epsilon": 0.00001
      },
      "position_encoding": {
        "type": "rope",
        "theta": 10000
      },
      "feed_forward": {
        "activation": "swiglu",
        "hidden_size": 512
      },
      "residual": true
    },
    "context": {
      "max-sequence-length": 256
    },
    "output_layer": {
      "type": "linear",
      "row": 8000,
      "col": 256,
      "weight_tying": true
    },
    "vocabulary": {
      "size": 8000,
      "tokenizer": "BPE"
    },
    "forward_propagation": {
      "repeat": 6,
      "input_shape": [256, 1],
      "output_shape": [256, 8000]
    },
    "training": {
      "objective": "next-token-prediction",
      "loss": "cross-entropy",
      "optimizer": "AdamW",
      "learning-rate": 0.0003,
      "weight-decay": 0.1,
      "batch-size": 16,
      "gradient-accumulation-steps": 4,
      "epochs": 1
    }
  }
}